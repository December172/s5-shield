#!/usr/bin/env bash
# s5-logictest: compile and RUN the real class predicates from src/s5_shield.c
# against this machine's live PCI classes, as a userspace C program.
# No root, no module loading, no mirroring.
#
# Why this exists: the shell mirror in s5-shield-dryrun and the C code drifted
# apart twice - first a wrong audio macro (0x0401 vs 0x0403), then a ">> 16"
# shift - and both times the module silently refused to load its own device
# list, so the fix did nothing. This test does not re-implement anything: it
# extracts the actual function bodies out of the source, compiles them with the
# kernel's own pci_ids.h, and feeds them the classes this machine really has,
# plus negative controls (NVMe, SATA) that must be refused.
set -euo pipefail

HERE=$(cd "$(dirname "$0")/.." && pwd)
SRC=${SRC:-$HERE/src/s5_shield.c}   # overridable, so the test can be pointed at a deliberate mutant
WORK=$(mktemp -d /tmp/s5-logictest.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

IDS=""
BUILD=""
for d in /lib/modules/"$(uname -r)"/build /lib/modules/*/build; do
	[ -f "$d/include/linux/pci_ids.h" ] && { IDS="$d/include/linux/pci_ids.h"; BUILD="$d"; break; }
done
[ -n "$IDS" ] || { echo "no kernel headers with pci_ids.h found" >&2; exit 1; }

[ -f "$SRC" ] || { echo "cannot find $SRC" >&2; exit 1; }

extract() { # $1 = function name -> prints its definition verbatim
	awk -v fn="$1" '
		/^(static|int|bool|unsigned)/ && index($0, fn "(") { on = 1 }
		on { print }
		on && /^}/ { exit }
	' "$SRC"
}

for fn in pci_class16 class_allowed; do
	body=$(extract "$fn")
	if [ -z "$body" ]; then
		echo "cannot extract $fn() from $SRC - refusing to guess" >&2
		exit 1
	fi
	printf '%s\n' "$body" >"$WORK/$fn.inc"
done

# live classes, straight from sysfs
c_gpu=$(cat /sys/bus/pci/devices/0000:01:00.0/class)
c_aud=$(cat /sys/bus/pci/devices/0000:01:00.1/class)
c_brg=$(cat /sys/bus/pci/devices/0000:00:01.1/class)

{
	echo '#include <stdio.h>'
	echo '#include <stdbool.h>'
	echo '#include <stdlib.h>'
	echo '#include <string.h>'
	echo 'struct pci_dev { unsigned int class; unsigned short vendor; unsigned short device; };'
	cat "$WORK/pci_class16.inc"
	cat "$WORK/class_allowed.inc"
	cat <<'EOF'
static int fails;

static void check(const char *what, unsigned int cls, bool want)
{
	struct pci_dev d = { .class = cls };
	bool got = class_allowed(&d);

	printf("  %-22s class=0x%06x  pci_class16=0x%04x  -> %-8s (want %-8s) %s\n",
	       what, cls, pci_class16(&d), got ? "allowed" : "refused",
	       want ? "allowed" : "refused", got == want ? "OK" : "FAIL");
	if (got != want)
		fails++;
}

int main(int argc, char **argv)
{
	if (argc < 4) {
		fprintf(stderr, "usage: %s <gpu_class> <audio_class> <bridge_class>\n", argv[0]);
		return 2;
	}

	/* the shift must decode a 24-bit class into the 16-bit macros */
	{
		struct pci_dev d = { .class = 0x030000 };
		printf("  shift sanity: pci_class16(0x030000) = 0x%04x (must be 0x0300)\n",
		       pci_class16(&d));
		if (pci_class16(&d) != 0x0300)
			fails++;
	}

	check("dGPU (display)",  strtoul(argv[1], NULL, 0), true);
	check("GPU audio",        strtoul(argv[2], NULL, 0), true);
	check("PCIe root port",   strtoul(argv[3], NULL, 0), true);
	check("NVMe (control)",   0x010802, false);
	check("SATA AHCI (control)", 0x010601, false);
	check("Ethernet (control)",  0x020000, false);

	printf("\n%s\n", fails ? "RESULT: FAIL - the module would mis-handle these devices"
			       : "RESULT: OK - the real predicates accept exactly this machine's trio and refuse the controls");
	return fails ? 1 : 0;
}
EOF
} >"$WORK/harness.c"

echo "compiling the real predicates from src/s5_shield.c with $(basename "$IDS") ..."
gcc -O1 -Wall -Wextra -Wno-unused-parameter -include "$IDS" -o "$WORK/harness" "$WORK/harness.c"

echo
"$WORK/harness" "$c_gpu" "$c_aud" "$c_brg"

# ---------------------------------------------------------------------------
# Second test: the runtime PM diagnostics, compiled out of the same source.
#
# The blocker line is what every "why is it still awake" conclusion is read
# through, so the same rule applies as above: compile the real function, do not
# mirror it.  The only things supplied here are the enum (extracted from the
# kernel's own include/linux/pm.h, never copied) and two-line stand-ins for the
# kernel types a userspace compile cannot include.
# ---------------------------------------------------------------------------
PMH="$BUILD/include/linux/pm.h"
[ -f "$PMH" ] || { echo "no include/linux/pm.h next to pci_ids.h" >&2; exit 1; }

for fn in rpm_name rpm_blocker; do
	body=$(extract "$fn")
	if [ -z "$body" ]; then
		echo "cannot extract $fn() from $SRC - refusing to guess" >&2
		exit 1
	fi
	printf '%s\n' "$body" >"$WORK/$fn.inc"
done

sed -n '/^enum rpm_status {/,/^};/p' "$PMH" >"$WORK/rpm_status.inc"
[ -s "$WORK/rpm_status.inc" ] || { echo "cannot read enum rpm_status from $PMH" >&2; exit 1; }

{
	echo '#include <stdio.h>'
	echo '#include <stdbool.h>'
	echo '#include <string.h>'
	cat "$WORK/rpm_status.inc"
	cat <<'EOF'
typedef struct { int counter; } atomic_t;
#define atomic_read(a) ((a)->counter)

/* the fields rpm_blocker() and rpm_accounting() read, nothing else */
struct dev_pm_info {
	atomic_t usage_count;
	atomic_t child_count;
	unsigned int disable_depth;
	bool runtime_auto;
	bool ignore_children;
	enum rpm_status runtime_status;
};

struct device {
	struct dev_pm_info power;
	struct device *parent;
};
EOF
	cat "$WORK/rpm_name.inc"
	cat "$WORK/rpm_blocker.inc"
	cat <<'EOF'
static int fails;

static void check(const char *what, struct device *d, const char *want)
{
	const char *got = rpm_blocker(d);
	bool ok = strstr(got, want) != NULL;

	printf("  %-36s -> %-70s %s\n", what, got, ok ? "OK" : "FAIL");
	if (!ok)
		fails++;
}

int main(void)
{
	struct device d;

	/* and the names come from the kernel's enum, not from a copy of it */
	printf("  enum sanity: RPM_ACTIVE=%d -> %s, RPM_SUSPENDED=%d -> %s\n",
	       RPM_ACTIVE, rpm_name(RPM_ACTIVE), RPM_SUSPENDED, rpm_name(RPM_SUSPENDED));
	if (strcmp(rpm_name(RPM_ACTIVE), "active") ||
	    strcmp(rpm_name(RPM_SUSPENDED), "suspended")) {
		printf("  enum sanity FAILED - pm.h no longer matches what this line prints\n");
		fails++;
	}

	memset(&d, 0, sizeof(d));
	d.power.runtime_status = RPM_ACTIVE;
	check("idle, nothing holding it", &d, "none in the runtime PM accounting");

	memset(&d, 0, sizeof(d));
	d.power.runtime_status = RPM_ACTIVE;
	d.power.disable_depth = 1;
	d.power.usage_count.counter = 2;
	check("disabled, and also in use", &d, "-EACCES");

	memset(&d, 0, sizeof(d));
	d.power.runtime_status = RPM_ACTIVE;
	d.power.usage_count.counter = 1;
	d.power.child_count.counter = 1;
	check("a held reference, and a child too", &d, "-EAGAIN");

	memset(&d, 0, sizeof(d));
	d.power.runtime_status = RPM_ACTIVE;
	d.power.child_count.counter = 1;
	check("active child (the root port's case)", &d, "-EBUSY");

	memset(&d, 0, sizeof(d));
	d.power.runtime_status = RPM_ACTIVE;
	d.power.ignore_children = true;
	d.power.child_count.counter = 1;
	check("a child, but ignore_children is set", &d, "none in the runtime PM accounting");

	memset(&d, 0, sizeof(d));
	d.power.runtime_status = RPM_SUSPENDED;
	check("already suspended", &d, "not active");

	printf("\n%s\n", fails ? "RESULT: FAIL - rpm_blocker() would name the wrong cause"
			       : "RESULT: OK - rpm_blocker() names each cause, in the kernel's own precedence");
	return fails ? 1 : 0;
}
EOF
} >"$WORK/rpm_harness.c"

echo
echo "compiling the runtime PM diagnostics from src/s5_shield.c with $(basename "$PMH") ..."
gcc -O1 -Wall -Wextra -Wno-unused-parameter -o "$WORK/rpm_harness" "$WORK/rpm_harness.c"

echo
"$WORK/rpm_harness"
